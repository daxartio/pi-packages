{
	"name": "pi-gpt-fast-mode",
	"version": "0.1.0",
	"description": "A Pi extension that toggles Fast mode with /fast by requesting service_tier 'priority', without model allowlists.",
	"type": "module",
	"module": "src/index.ts",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"codex",
		"fast-mode"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "bun test ./test/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	},
	"files": [
		"src"
	]
}
