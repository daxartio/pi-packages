{
  "name": "pi-gpt-fast-mode",
  "version": "0.1.0",
  "description": "A Pi extension that toggles supported GPT-5 and GPT-6 models into Fast mode with /fast (service tier 'priority').",
  "type": "module",
  "module": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "gpt-5.4",
    "gpt-5.5",
    "gpt-5.6",
    "gpt-6",
    "codex",
    "fast-mode"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test ./test/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/bun": "latest",
    "typescript": "^6"
  },
  "files": [
    "src"
  ]
}
