    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "tsx": "^4.22.3"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
