{
  "name": "pi-worktree",
  "version": "0.1.0",
  "description": "Safe managed Git worktree lifecycle for Pi.",
  "type": "module",
  "module": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "git",
    "worktree"
  ],
  "pi": {
    "extensions": [
